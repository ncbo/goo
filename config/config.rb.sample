Goo.config do |config|
  # 4store
  config.goo_backend_name    = '4store'
  config.goo_port            =  9000
  config.goo_host            = 'localhost'
  config.goo_path_query      = '/sparql/'
  config.goo_path_data       = '/data/'
  config.goo_path_update     = '/update/'

  # AllegroGraph
  # config.goo_backend_name  = 'allegrograph'
  # config.goo_port          = 10035
  # config.goo_host          = 'localhost'
  # config.goo_path_query    = "/repositories/ontoportal"
  # config.goo_path_data     = "/repositories/ontoportal/statements/"
  # config.goo_path_update   = "/repositories/ontoportal/statements/"

  config.search_server_url   = 'http://localhost:8983/solr/'
  config.goo_redis_host      = 'localhost'
  config.goo_redis_port      = 6379
  config.bioportal_namespace = 'http://data.bioontology.org/'

  # Mounts Goo::Debug, which adds ncbo-time-goo-* and ncbo-sparql-query-count response headers.
  # The query count itself is always collected (Goo.request_query_count); this only controls
  # whether it is published to API callers.
  config.queries_debug       = false

  # SPARQL query logging (off by default; env equivalent OP_QUERIES_LOGGING).
  # config.query_logging      = true
  # config.query_logging_file = '/var/log/goo/sparql.log'
  #
  # Give the log its own Redis instance. maxmemory/allkeys-lru is per-instance and ignores key
  # prefixes and db numbers, so pointing the log at the cache Redis lets log volume evict cache
  # entries (de-fork review D6a). Defaults to the cache Redis above when unset.
  # config.query_logging_redis_host = 'localhost'
  # config.query_logging_redis_port = 6380
  #
  # Ring-buffer depth and per-entry TTL (env: OP_QUERIES_LOGGING_MAX_LOGS / OP_QUERIES_LOGGING_TTL).
  # max_logs must exceed the query count of the request you are investigating: a single class-tree
  # request issues ~2000 reads, so a smaller buffer trims away its own entries before you can read
  # them. 10k entries is roughly 15-20 MB of JSON-with-SPARQL-text.
  # config.query_logging_max_logs = 10_000
  # config.query_logging_ttl      = 86_400
end
